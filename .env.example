# Copy to .env and adjust. Compose falls back to these defaults when unset,
# so local `docker compose up` works with no .env at all.
DB_HOST=db
DB_NAME=schoolar_db
DB_USER=schoolar
DB_PASS=schoolarpass
DB_ROOT_PASS=rootpass

# Host port for the app. Local default 8080; use 80 in production.
APP_PORT=8080

# Base path of the app in URLs.
# XAMPP:  APP_BASE=/SCHOOlar  (http://localhost/SCHOOlar/...)
# Docker: APP_BASE=           (http://localhost:8080/...)
APP_BASE=
