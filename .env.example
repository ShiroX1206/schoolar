# Copy to .env and adjust. Docker Compose already sets these for the `web` service;
# this file documents them and is handy for local overrides via `env_file`.
DB_HOST=db
DB_NAME=schoolar_db
DB_USER=schoolar
DB_PASS=schoolarpass

# Base path of the app in URLs.
# XAMPP:  APP_BASE=/SCHOOlar  (http://localhost/SCHOOlar/...)
# Docker: APP_BASE=           (http://localhost:8080/...)
APP_BASE=
